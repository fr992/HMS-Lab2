# Copy this file to hms-frontend/.env and replace values as needed.
# VITE_API_BASE_URL must match the backend HTTPS URL and include /api.

# Backend API
VITE_API_BASE_URL=https://localhost:5001/api

# App
VITE_APP_ENV=development
VITE_SEQ_URL=http://localhost:5341

# Optional auth providers (currently unused)
VITE_OAUTH_CLIENT_ID=
VITE_AUTH0_DOMAIN=
VITE_CLERK_PUBLISHABLE_KEY=

# Stripe publishable key
VITE_STRIPE_PUBLISHABLE_KEY=
