# Copy this file to backend/.env and replace values for your machine.
# The API and EF design-time tooling automatically load backend/.env.

# Runtime
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=https://localhost:5001;http://localhost:5000
HMS_API_BASE_URL=https://localhost:5001
AllowedHosts=*
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# SQL Server
# Example:
# Server=YOUR_MACHINE\YOUR_INSTANCE;Database=HMS;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True
ConnectionStrings__HMS=
ConnectionStrings__Default=
HMS_EF_CONNECTION=

# MongoDB
MongoDb__ConnectionString=mongodb://localhost:27017
MongoDb__DatabaseName=HMS
MongoDb__NotificationsCollectionName=notifications
MongoDb__ServerSelectionTimeoutSeconds=5

# JWT
# Use a strong secret containing at least 32 UTF-8 characters.
Jwt__Key=
Jwt__Issuer=HMS
Jwt__Audience=HMS
Jwt__AccessTokenMinutes=120

# Stripe
Stripe__SecretKey=
Stripe__PublishableKey=
Stripe__WebhookSecret=
Stripe__SuccessUrl=http://localhost:5173/payment-success?session_id={CHECKOUT_SESSION_ID}
Stripe__CancelUrl=http://localhost:5173/payment-cancel

# Frontend
Frontend__BaseUrl=http://localhost:5173

# SMTP email notifications
# For Gmail, use an app password rather than the account password.
Notifications__Email__Enabled=false
Notifications__Email__Host=smtp.gmail.com
Notifications__Email__Port=587
Notifications__Email__UseSsl=true
Notifications__Email__UserName=
Notifications__Email__Password=
Notifications__Email__FromAddress=
Notifications__Email__FromName=Nexora Hospital

# Serilog / Seq / SQL audit sink
Serilog__Seq__ServerUrl=http://localhost:5341
Serilog__SqlServer__ConnectionStringName=HMS
Serilog__SqlServer__TableName=SystemAuditLogs
Serilog__SqlServer__AutoCreateSqlTable=true
Serilog__SqlServer__BatchPostingLimit=50
Serilog__SqlServer__BatchPeriodSeconds=5

# Bootstrap seed data
Seed__EnsureRoles=true
Seed__EnsureBootstrapAdmin=true
Seed__AdminUserName=admin
Seed__AdminEmail=admin@hms.local
Seed__AdminPassword=
Seed__AdminFirstName=System
Seed__AdminLastName=Administrator

# Logging
Logging__LogLevel__Default=Information
Logging__LogLevel__Microsoft.AspNetCore=Warning
